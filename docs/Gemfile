source "https://rubygems.org"

# This Gemfile is only used for local preview:
#
#     bundle install
#     bundle exec jekyll serve
#
# GitHub Pages builds the published site with its own gem set and ignores
# this file. Since the site no longer depends on a theme gem or any plugin
# outside the Pages allowlist, plain Jekyll matches production closely.

gem "jekyll", "~> 4.3"
gem "webrick", "~> 1.8"

group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.17"
end
